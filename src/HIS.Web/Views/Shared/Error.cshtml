@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}
<main class="page-shell">
    <div class="empty-state">
        <i data-lucide="circle-alert"></i>
        <strong>Có lỗi xảy ra khi xử lý yêu cầu</strong>
        <p>Vui lòng thử lại sau ít phút hoặc liên hệ 1900 6868 để được hỗ trợ.</p>
        @if (Model.ShowRequestId)
        {
            <p>Mã yêu cầu: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Về trang bắt đầu đặt lịch</a>
    </div>
</main>
